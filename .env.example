# Copy to .env.local and fill in values from the Supabase dashboard
# (Project Settings -> API Keys). Never commit .env.local.

# Public: safe to expose to the browser (still protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server/test only: NEVER prefix with NEXT_PUBLIC_ or import in app code.
# Used by the RLS and E2E tests to create and delete throwaway users.
SUPABASE_SECRET_KEY=sb_secret_...
# Used by the Supabase CLI (db push) when it prompts for the database password.
SUPABASE_DB_PASSWORD=

# Web Push reminders (Phase 20). Generate a key pair once (see docs/deployment.md).
# The public key is safe to expose and also goes to Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-side only, used by the Supabase Edge Function `send-reminders`
# (set them with `npx supabase secrets set`), never in Vercel or client code.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.example
REMINDERS_SECRET=
